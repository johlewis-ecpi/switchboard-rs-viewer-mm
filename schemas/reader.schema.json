{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Switchboard installable reader manifest (API v1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "id", "name", "extensions", "entry"],
  "properties": {
    "apiVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]{0,119}$"},
    "name": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "version": {"type": "string"},
    "extensions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"}},
    "entry": {"type": "string", "minLength": 1, "description": "Relative file path inside the package; starter builds require index.html. File containment and case-insensitive extension uniqueness require additional checks."}
  }
}
