{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Switchboard viewer API v1 messages",
  "oneOf": [{"$ref": "#/$defs/ready"}, {"$ref": "#/$defs/open"}, {"$ref": "#/$defs/rendered"}, {"$ref": "#/$defs/error"}],
  "$defs": {
    "request": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "ready": {"type": "object", "required": ["type", "apiVersion"], "properties": {"type": {"const": "switchboard:ready"}, "apiVersion": {"const": 1}}},
    "open": {"type": "object", "required": ["type", "apiVersion", "request", "document"], "properties": {
      "type": {"const": "switchboard:open"}, "apiVersion": {"const": 1}, "request": {"$ref": "#/$defs/request"},
      "document": {"type": "object", "required": ["name", "extension", "text", "readOnly"], "properties": {"name": {"type": "string"}, "extension": {"type": "string"}, "text": {"type": "string"}, "readOnly": {"const": true}}}
    }},
    "rendered": {"type": "object", "required": ["type", "apiVersion", "request"], "properties": {"type": {"const": "switchboard:rendered"}, "apiVersion": {"const": 1}, "request": {"$ref": "#/$defs/request"}}},
    "error": {"type": "object", "required": ["type", "apiVersion", "request", "message"], "properties": {"type": {"const": "switchboard:error"}, "apiVersion": {"const": 1}, "request": {"$ref": "#/$defs/request"}, "message": {"type": "string", "maxLength": 2000}}}
  },
  "$comment": "Schema validation cannot verify MessageEvent.source, sandbox policy, ordering, asynchronous cancellation, or visual correctness. See SPEC.md. Unknown fields can be ignored by receivers."
}
